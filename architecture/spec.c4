// Element kinds, tags, and custom colors for the Wheel Practice App model.
//
// Tags encode delivery state so in-flight / planned work is visually distinct
// from what already ships:
//   #built     — code path exists, is exercised, and has tests
//   #evolving  — built, but the contract is still moving (migration in flight)
//   #planned   — designed, not yet implemented (PRD requirement, no code yet)
//   #research  — speculative track (history/ premortem, not committed)

specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color slate
    }
  }

  element system

  element container {
    style {
      shape rectangle
    }
  }

  element component

  element datastore {
    style {
      shape cylinder
    }
  }

  // Deployment model — where each piece runs / is built at review time.
  deploymentNode host {
    style {
      shape rectangle
      color slate
    }
  }
  deploymentNode proc

  tag built {
    color #16a34a
  }
  tag evolving {
    color #d97706
  }
  tag planned {
    color #64748b
  }
  tag research {
    color #6366f1
  }

  // Cross-cutting: carried by any element that is a known risk / open question
  // for the design review (in addition to its delivery-state tag).
  tag risk {
    color #dc2626
  }
}
